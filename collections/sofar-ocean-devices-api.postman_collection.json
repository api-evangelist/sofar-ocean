          "id": "c1c28997-f22a-4d3a-89b4-4aa83f1dd27e",
          "name": "List devices",
          "request": {
            "name": "List devices",
            "description": {
              "content": "Retrieve a list containing the display name, Spotter ID, and hull type of any Spotters you have API access to (registered to or shared with your account), ordered by spotterId.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "devices"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "excludeSharedDevices",
                  "value": "false",
                  "description": "Set true to limit the response to Spotters registered directly to your account."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "c1d087d3-827f-4083-b157-8698282243dd",
              "name": "A list of Spotters associated with the account.",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "devices"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "excludeSharedDevices",
                      "value": "false"
                    }
                  ],
                  "variable": []
                },
                "header": [
