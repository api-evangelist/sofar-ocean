                    },
                    "key": "token",
                    "value": "<API Key>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"message\": \"string\",\n  \"data\": {\n    \"devices\": [\n      {\n        \"spotterId\": \"string\",\n        \"name\": \"string\",\n        \"hullType\": \"scout\"\n      },\n      {\n        \"spotterId\": \"string\",\n        \"name\": \"string\",\n        \"hullType\": \"spotter\"\n      }\n    ]\n  }\n}",
              "cookie": [],
