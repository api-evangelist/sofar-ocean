      "item": [
        {
          "id": "25da6846-3163-4442-99fb-0a098e9489db",
          "name": "Get Smart Mooring sensor data",
          "request": {
            "name": "Get Smart Mooring sensor data",
            "description": {
              "content": "Returns Smart Mooring sensor data collected and transmitted by a Spotter, specified by spotterId, between startDate and endDate.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "sensor-data"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "spotterId",
                  "value": "<string>",
                  "description": "(Required) The Spotter ID of the device to retrieve data from."
                },
                {
                  "disabled": false,
                  "key": "startDate",
                  "value": "<dateTime>",
                  "description": "ISO 8601 start date (defaults to 24 hours ago)."
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<dateTime>",
                  "description": "ISO 8601 end date (defaults to now)."
                },
                {
                  "disabled": false,
                  "key": "includeSoundPressureReadings",
                  "value": "false",
                  "description": "Set true to return sound pressure level (SPL) readings from hydrophone Spotters via cellular."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
