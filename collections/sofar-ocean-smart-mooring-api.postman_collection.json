        {
          "id": "49a6c8b9-6878-45c9-bc36-8858b2974272",
          "name": "Get Smart Mooring sensor configuration history",
          "request": {
            "name": "Get Smart Mooring sensor configuration history",
            "description": {
              "content": "Retrieve Smart Mooring sensor configurations from a Spotter for a specified time window. Configurations can be cross-referenced with the configuration_checksum returned by the Sensor Data endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "sensor-configuration-history"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "spotterId",
                  "value": "<string>",
                  "description": "(Required) The Spotter ID of the device to retrieve configurations from."
                },
                {
                  "disabled": false,
                  "key": "startDate",
                  "value": "<dateTime>",
                  "description": "ISO 8601 start date for the configuration window."
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<dateTime>",
                  "description": "ISO 8601 end date for the configuration window."
